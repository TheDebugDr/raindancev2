# Copy to .env and fill in. .env is gitignored — keep real secrets out of git.

# Restock alerts (optional). Create a webhook in your Discord server:
# Server Settings → Integrations → Webhooks → New Webhook → Copy URL.
# Leave blank to disable Discord alerts (desktop + sound still work).
DISCORD_WEBHOOK=

# Store login (only needed if login.enabled = true)
SHOP_EMAIL=you@example.com
SHOP_PASSWORD=changeme

# Shipping details
SHIP_FIRST_NAME=Jane
SHIP_LAST_NAME=Doe
SHIP_ADDRESS1=123 Main St
SHIP_CITY=Springfield
SHIP_STATE=CA
SHIP_ZIP=90001
SHIP_PHONE=5555550100

# Payment details
CARD_NAME=Jane Doe
CARD_NUMBER=4111111111111111
CARD_EXPIRY=12/28
CARD_CVC=123
